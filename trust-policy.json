{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "AgentCoreTrustPolicy",
      "Effect": "Allow",
      "Principal": {
        "Service": "bedrock-agentcore.amazonaws.com"
      },
      "Action": "sts:AssumeRole",
      "Condition": {
        "StringEquals": {
          "aws:SourceAccount": "283548940267"
        },
        "ArnLike": {
          "aws:SourceArn": "arn:aws:bedrock-agentcore:ap-south-2:283548940267:*"
        }
      }
    }
  ]
}
